---
import { concepts } from '../../data/concepts';
import { withBase } from '../../lib/paths';
import { loadScene } from './scenes';

const cards = await Promise.all(
  concepts.map(async (entry) => ({ entry, Scene: (await loadScene(entry.slug)).with })),
);
---

<div class="sdv-concept-cards not-content">
  <ul class="sdv-concept-cards__grid">
    {
      cards.map(({ entry, Scene }) => (
        <li>
          <a class="sdv-card sdv-concept-card" href={withBase(`/concepts/${entry.slug}/`)}>
            <span class="sdv-concept-card__thumb">
              <Scene idPrefix={`sdv-card-${entry.slug}`} thumb />
            </span>
            <span class="sdv-concept-card__title">{entry.title}</span>
            <span class="sdv-concept-card__text">{entry.definition}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="sdv-concept-cards__credit">
    Topic list inspired by the <a href="https://github.com/donnemartin/system-design-primer">System Design Primer</a> (CC
    BY 4.0)
  </p>
</div>
