---
import { CONCEPT_COPY, concept, lessonTitle } from '../../data/concepts';
import { course } from '../../data/courses';
import { lessonHref } from '../../lib/paths';
import Quiz from '../lesson/Quiz';
import ConceptFigure from './ConceptFigure.astro';
import ConceptVariants from './ConceptVariants.astro';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const entry = concept(slug);
const deeper = lessonTitle(entry);
const bullets = [
  [CONCEPT_COPY.useWhen, entry.tradeoffs.useWhen],
  [CONCEPT_COPY.costs, entry.tradeoffs.costs],
  [CONCEPT_COPY.realExample, entry.tradeoffs.realExample],
  [CONCEPT_COPY.watchOut, entry.tradeoffs.watchOut],
] as const;
---

<p class="sdv-concept-lead">{entry.definition}</p>
<p class="sdv-concept-analogy"><strong>{CONCEPT_COPY.analogy}</strong> {entry.analogy}</p>

<ConceptFigure slug={slug} />

<h2 class="sdv-concept-heading">{CONCEPT_COPY.steps}</h2>
<ol class="sdv-concept-steps">{entry.steps.map((step) => <li>{step}</li>)}</ol>

<ConceptVariants slug={slug} />

<section class="sdv-concept-example not-content" aria-labelledby={`sdv-example-${slug}`}>
  <p class="sdv-concept-example__title" id={`sdv-example-${slug}`}>
    <strong>{CONCEPT_COPY.example}</strong>{' '}
    {entry.example.title}
  </p>
  {entry.example.lines.map((line) => <p>{line}</p>)}
</section>

<ul class="sdv-concept-bullets">
  {
    bullets.map(([lead, text]) => (
      <li>
        <strong>{lead}</strong> {text}
      </li>
    ))
  }
</ul>

<Quiz client:visible questions={entry.quiz} title={CONCEPT_COPY.quiz} />

{
  entry.lesson && deeper && (
    <p class="sdv-concept-deeper">
      <a href={lessonHref(entry.lesson)}>
        {CONCEPT_COPY.deeper} {deeper}
      </a>
    </p>
  )
}

<h2 class="sdv-concept-heading">{CONCEPT_COPY.learnMore}</h2>
<ul class="sdv-concept-links">
  {
    entry.learnMore.map((link) => (
      <li>
        <a href={link.href}>
          {course(link.course).name}: {link.label}
        </a>
      </li>
    ))
  }
</ul>
