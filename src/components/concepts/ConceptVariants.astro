---
import { concept } from '../../data/concepts';
import { loadScene } from './scenes';
import { keepNumbersWithWords } from './text';
import { VariantArt } from './VariantArt';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const entry = concept(slug);
const scene = await loadScene(slug);
if (scene.variants.length !== entry.variants.length) {
  throw new Error(
    `concept "${slug}" has ${entry.variants.length} variants in its data but ${scene.variants.length} drawings`,
  );
}
const items = entry.variants.map((variant, index) => {
  const draw = scene.variants[index];
  if (!draw) throw new Error(`concept "${slug}" has no drawing for variant ${index}`);
  return { variant, draw };
});
---

<ul class="sdv-concept-variants not-content" aria-label={`${entry.title} variants`}>
  {
    items.map(({ variant, draw }, index) => (
      <li class="sdv-concept-variants__item">
        <VariantArt draw={draw} variant={variant} idPrefix={`sdv-variant-${slug}-${index}`} />
        <p>
          <strong>{keepNumbersWithWords(variant.name)}</strong>
          <span>{keepNumbersWithWords(variant.caption)}</span>
        </p>
      </li>
    ))
  }
</ul>
