---
import { type ConceptSlug, concept, ILLUSTRATIVE_NOTE } from '../../data/concepts';
import { UiIcon } from '../viz/icons';
import { scenes } from './scenes';

interface Props {
  slug: ConceptSlug;
  /** Unique on the page; defaults to the slug. */
  id?: string;
  /** Smaller frame for the home hero. */
  compact?: boolean;
}

const { slug, id = slug, compact = false } = Astro.props;
const entry = concept(slug);
const prefix = `sdv-concept-${id}`;
const order = ['without', 'with'] as const;
const Without = scenes[slug].without;
const With = scenes[slug].with;
---

<figure class="sdv-concept not-content" data-concept={slug} data-compact={compact ? '' : undefined}>
  <div class="sdv-concept__bar">
    <div class="sdv-segmented sdv-concept__toggle">
      <fieldset class="sdv-control sdv-segmented__group" role="radiogroup" aria-labelledby={`${prefix}-legend`}>
        <legend id={`${prefix}-legend`} class="sdv-visually-hidden">{`${entry.title} picture`}</legend>
        <div class="sdv-segmented__options">
          {
            order.map((state) => (
              <label>
                <input type="radio" name={`${prefix}-view`} value={state} checked={state === 'without'} />
                <span data-label={entry.states[state].label}>{entry.states[state].label}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
    </div>
    <div class="sdv-concept__controls">
      <button type="button" class="sdv-button sdv-button--icon" data-action="toggle" aria-label="Play animation">
        <span class="sdv-concept__icon sdv-concept__icon--pause"><UiIcon name="pause" /></span>
        <span class="sdv-concept__icon sdv-concept__icon--play"><UiIcon name="play" /></span>
      </button>
      <button type="button" class="sdv-button sdv-button--icon" data-action="replay" aria-label="Replay animation">
        <UiIcon name="reset" />
      </button>
    </div>
  </div>
  <div class="sdv-concept__stage">
    <div class="sdv-concept__state" data-state="without">
      <Without idPrefix={`${prefix}-without`} />
      <ol class="sdv-concept__captions">{entry.states.without.captions.map((caption) => <li>{caption}</li>)}</ol>
    </div>
    <div class="sdv-concept__state" data-state="with">
      <With idPrefix={`${prefix}-with`} />
      <ol class="sdv-concept__captions">{entry.states.with.captions.map((caption) => <li>{caption}</li>)}</ol>
    </div>
  </div>
  {entry.illustrative && <p class="sdv-concept__fine">{ILLUSTRATIVE_NOTE}</p>}
</figure>

<script>
  import { setupConceptFigures } from './player';

  setupConceptFigures();
</script>
