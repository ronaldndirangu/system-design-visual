---
import { conceptMetadata } from '../../data/conceptMetadata';
import { withBase } from '../../lib/paths';

interface Props {
  prominent?: boolean;
}
const { prominent = false } = Astro.props;
---

<div class="sdv-continue not-content" data-concept-metadata={JSON.stringify(conceptMetadata)} data-prominent={prominent ? '' : undefined} hidden={!prominent}>
  <a class="sdv-button sdv-button--primary" href={withBase('/#learn-fundamentals')} data-continue-link>
    <span data-continue-title>Start with fundamentals</span>
  </a>
  <a class="sdv-continue__review" href={withBase('/review/')} data-continue-review hidden={prominent}>Review</a>
</div>

<script>
  import { type ConceptMetadata, guidedContinueTarget, journeyById, journeyIncludes } from '../../data/journeys';
  import { lessonHref, withBase } from '../../lib/paths';
  import { hasStarted, readProgress, subscribeProgress } from '../../lib/progress';

  function paint() {
    const progress = readProgress();
    const started = hasStarted(progress);
    for (const root of document.querySelectorAll<HTMLElement>('.sdv-continue')) {
      const metadata: ConceptMetadata = JSON.parse(root.dataset.conceptMetadata ?? '{}');
      const target = guidedContinueTarget(progress, metadata);
      const prominent = root.hasAttribute('data-prominent');
      const link = root.querySelector<HTMLAnchorElement>('[data-continue-link]');
      const title = root.querySelector('[data-continue-title]');
      const review = root.querySelector<HTMLAnchorElement>('[data-continue-review]');
      if (review) review.hidden = prominent && !started;
      root.hidden = (!prominent && !started) || !link || !title;
      if (link) link.hidden = !target && !prominent;
      if (target && link && title) {
        const journey = journeyById(progress.journey);
        link.href = lessonHref(target.id, journey && journeyIncludes(journey, target.id) ? journey.id : undefined);
        title.textContent = `Continue: ${target.title}`;
      } else if (prominent && link && title) {
        link.href = started ? lessonHref('journeys') : withBase('/#learn-fundamentals');
        title.textContent = started ? 'Choose a learning path' : 'Start with fundamentals';
      }
    }
  }

  paint();
  subscribeProgress(paint);
</script>
