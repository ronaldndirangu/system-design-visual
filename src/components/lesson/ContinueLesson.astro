---
import { allLessons } from '../../data/curriculum';
import { lessonHref, withBase } from '../../lib/paths';

const lessons = allLessons.map((lesson) => ({
  id: lesson.id,
  title: lesson.title,
  href: lessonHref(lesson.id),
}));
---

<p class="sdv-continue not-content" data-lessons={JSON.stringify(lessons)} hidden>
  <a class="sdv-button sdv-button--primary" href={lessons[0]?.href} data-continue-link>
    Continue: <span data-continue-title>{lessons[0]?.title}</span>
  </a>
  <a class="sdv-continue__review" href={withBase('/review/')}>Review</a>
</p>

<script>
  import { pathContinueTarget } from '../../data/coursePath';
  import { hasStarted, readProgress, subscribeProgress } from '../../lib/progress';

  interface Target {
    id: string;
    title: string;
    href: string;
  }

  function paint() {
    const progress = readProgress();
    const started = hasStarted(progress);
    const next = pathContinueTarget(progress);
    for (const root of document.querySelectorAll<HTMLElement>('.sdv-continue[data-lessons]')) {
      const lessons: Target[] = JSON.parse(root.dataset.lessons ?? '[]');
      const target = next ? lessons.find((lesson) => lesson.id === next.id) : undefined;
      const link = root.querySelector<HTMLAnchorElement>('[data-continue-link]');
      const title = root.querySelector('[data-continue-title]');
      root.hidden = !started || !link || !title;
      if (link) link.hidden = !target;
      if (target && link && title) {
        link.href = target.href;
        title.textContent = target.title;
      }
    }
  }

  paint();
  subscribeProgress(paint);
</script>
