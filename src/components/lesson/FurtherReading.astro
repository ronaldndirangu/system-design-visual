---
interface Source {
  title: string;
  url: string;
  note?: string;
}

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;
---

{
  sources.length > 0 && (
    <section class="sdv-reading not-content" aria-labelledby="sdv-reading-title">
      <h2 id="sdv-reading-title" class="sdv-reading__title">
        Further reading
      </h2>
      <ul class="sdv-reading__list">
        {sources.map((source) => (
          <li>
            <a href={source.url} rel="noopener">
              {source.title}
            </a>
            {source.note && <span class="sdv-reading__note">{source.note}</span>}
          </li>
        ))}
      </ul>
    </section>
  )
}
