---
import Callout from './Callout.astro';

interface Props {
  title?: string;
}
const { title = 'Design challenge' } = Astro.props;
---

<Callout variant="challenge" title={title} class="sdv-challenge">
  <slot />
  <details class="sdv-challenge__details">
    <summary>Show one possible answer</summary>
    <div class="sdv-challenge__answer"><slot name="answer" /></div>
  </details>
</Callout>
