---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { allLessons, findLesson, findModuleForLesson, lessonPosition } from '../../data/curriculum';

const id = Astro.locals.starlightRoute.id;
const lesson = findLesson(id);
const module = findModuleForLesson(id);
const position = lessonPosition(id);
---

{
  lesson && module && position ? (
    <div class="sdv-lesson-meta not-content">
      <p class="sdv-lesson-meta__module">
        Module {module.number}: {module.title}
      </p>
      <Default />
      <p class="sdv-lesson-meta__facts">
        <span>
          Lesson {position} of {allLessons.length}
        </span>
        <span>About {lesson.minutes} minutes</span>
        <span>Example: {module.example}</span>
      </p>
    </div>
  ) : (
    <Default />
  )
}
