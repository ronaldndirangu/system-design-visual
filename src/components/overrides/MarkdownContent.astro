---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import { findLesson, readyLessons } from '../../data/curriculum';
import { lessonHref } from '../../lib/paths';
import LessonComplete from '../lesson/LessonComplete';

const id = Astro.locals.starlightRoute.id;
const lesson = findLesson(id);
const index = readyLessons.findIndex((candidate) => candidate.id === lesson?.id);
const next = index >= 0 ? readyLessons[index + 1] : undefined;
---

<Default><slot /></Default>
{
  lesson?.status === 'ready' && (
    <LessonComplete
      client:visible
      lessonId={lesson.id}
      title={lesson.title}
      nextHref={next ? lessonHref(next.id) : undefined}
      nextTitle={next?.title}
    />
  )
}
