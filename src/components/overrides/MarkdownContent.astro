---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import { allLessons, findLesson } from '../../data/curriculum';
import { lessonHref } from '../../lib/paths';
import FurtherReading from '../lesson/FurtherReading.astro';
import LessonComplete from '../lesson/LessonComplete';

const { id, entry } = Astro.locals.starlightRoute;
const lesson = findLesson(id);
const index = allLessons.findIndex((candidate) => candidate.id === lesson?.id);
const next = index >= 0 ? allLessons[index + 1] : undefined;
const sources = entry.data.furtherReading ?? [];
---

<Default><slot /></Default>
{lesson && <span hidden data-lesson-id={lesson.id} />}
{lesson && <FurtherReading sources={sources} />}
{
  lesson && (
    <LessonComplete
      client:visible
      lessonId={lesson.id}
      title={lesson.title}
      nextHref={next ? lessonHref(next.id) : undefined}
      nextTitle={next?.title}
    />
  )
}

<script>
  import { recordVisit } from '../../lib/progress';

  const marker = document.querySelector<HTMLElement>('span[data-lesson-id]');
  if (marker?.dataset.lessonId) recordVisit(marker.dataset.lessonId);
</script>
