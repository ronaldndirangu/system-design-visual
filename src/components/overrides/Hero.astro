---
import { LinkButton } from '@astrojs/starlight/components';
import Default from '@astrojs/starlight/components/Hero.astro';
import { firstLesson } from '../../data/coursePath';
import { lessonHref } from '../../lib/paths';
import LandingHero from '../landing/LandingHero';

const route = Astro.locals.starlightRoute;
const isHome = route.id === '';
const hero = route.entry.data.hero;
const title = hero?.title ?? route.entry.data.title;
---

{
  isHome ? (
    <div class="sdv-hero">
      <div class="sdv-hero__copy">
        <p class="sdv-hero__kicker">A free, visual, hands-on course</p>
        <h1 id="_top" data-page-title set:html={title} />
        {hero?.tagline && <p class="sdv-hero__tagline" set:html={hero.tagline} />}
        <div class="sdv-hero__actions">
          {firstLesson && (
            <LinkButton href={lessonHref(firstLesson.id)} icon="right-arrow">
              Start with one request
            </LinkButton>
          )}
          <LinkButton href="#routing-challenge" variant="minimal">
            Try the routing challenge
          </LinkButton>
        </div>
        <p class="sdv-hero__note">Free. No account needed. Progress stays in this browser.</p>
      </div>
      <div class="sdv-hero__challenge">
        <LandingHero client:idle />
      </div>
    </div>
  ) : (
    <Default />
  )
}
