---
import { anchorFor, curriculum, difficultyLabels, findModule } from '../../data/curriculum';
import { lessonHref } from '../../lib/paths';
import ContinueLesson from '../lesson/ContinueLesson.astro';

interface Props {
  /** Use h3 headings when the map sits under a page section heading. */
  headingLevel?: 2 | 3;
  /** `summary` shows one line per module and folds its lessons into a native disclosure. */
  variant?: 'full' | 'summary';
}

const { headingLevel = 2, variant = 'full' } = Astro.props;
const summary = variant === 'summary';
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---

<div class:list={['sdv-map', 'not-content', { 'sdv-map--summary': summary }]}>
  {!summary && <ContinueLesson />}
  {
    curriculum.map((module) => {
      const lessons = (
        <ol class="sdv-map__lessons">
          {module.lessons.map((lesson) => (
            <li id={summary ? undefined : anchorFor(lesson.id)} class="sdv-map__lesson" data-lesson-id={lesson.id}>
              <a href={lessonHref(lesson.id)} class="sdv-map__link">
                {lesson.title}
              </a>
              <span class="sdv-map__lesson-summary">{lesson.summary}</span>
              <span class="sdv-map__tags">
                <span class="sdv-badge sdv-badge--neutral">{lesson.minutes} min</span>
                <span class="sdv-badge sdv-badge--ok sdv-map__done" hidden>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12l4 4l10-10" fill="none" stroke="currentColor" stroke-width="2.5" />
                  </svg>
                  Completed
                </span>
                {lesson.format === 'card' && <span class="sdv-badge sdv-badge--neutral">Quick card</span>}
                {lesson.optional && <span class="sdv-badge sdv-badge--neutral">Optional deep dive</span>}
                <span class:list={['sdv-badge', lesson.advanced ? 'sdv-badge--warn' : 'sdv-badge--neutral']}>
                  {difficultyLabels[lesson.difficulty]}
                </span>
                {lesson.bestAfter && (
                  <span class="sdv-badge sdv-badge--neutral">
                    Best after module {findModule(lesson.bestAfter)?.number}
                  </span>
                )}
              </span>
            </li>
          ))}
        </ol>
      );
      return (
        <section class="sdv-map__module" id={summary ? undefined : anchorFor(module.id)} aria-labelledby={`map-${module.id}`}>
          <header class="sdv-map__header">
            <span class="sdv-map__number" aria-hidden="true">
              {module.number}
            </span>
            <Heading class="sdv-map__title" id={`map-${module.id}`}>
              <span class="sdv-visually-hidden">Module {module.number}: </span>
              {module.title}
            </Heading>
            {!summary && <span class="sdv-badge sdv-badge--ok">{module.lessons.length} lessons</span>}
            <p class="sdv-map__summary">{module.summary}</p>
            {!summary && <p class="sdv-map__example">Running example: {module.example}</p>}
          </header>
          {summary ? (
            <details class="sdv-map__more">
              <summary>
                {module.lessons.length} lessons
                <span class="sdv-visually-hidden"> in {module.title}</span>
              </summary>
              {lessons}
            </details>
          ) : (
            lessons
          )}
        </section>
      );
    })
  }
</div>

<script>
  import { isComplete, readProgress, subscribeProgress } from '../../lib/progress';

  function paint() {
    const progress = readProgress();
    for (const item of document.querySelectorAll<HTMLElement>('.sdv-map__lesson[data-lesson-id]')) {
      const done = Boolean(item.dataset.lessonId && isComplete(progress, item.dataset.lessonId));
      item.toggleAttribute('data-complete', done);
      const badge = item.querySelector<HTMLElement>('.sdv-map__done');
      if (badge) badge.hidden = !done;
    }
  }

  paint();
  subscribeProgress(paint);
</script>
